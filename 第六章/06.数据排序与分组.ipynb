   "source": [
    "import pandas as pd\n",
    "df = pd.read_csv(\"resource/sales_200_rows.csv\", nrows = 10)\n",
    "\n",
    "\n",
    "# 2、排序\n",
    "# 2.1 根据 单价 倒序排序\n",
    "df.sort_values(by = \"单价_人民币元\") # 默认是升序排序\n",
    "\n",
    "# 2.2 根据 数量 升序排序\n",
    "df.sort_values(by = \"数量\", ascending = True)\n",
    "\n",
    "# 2.3 多列排序\n",
    "df.sort_values(by = [\"数量\", \"单价_人民币元\"], ascending = [True, True])"
